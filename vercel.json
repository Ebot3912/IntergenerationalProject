{
  "buildCommand": "npx expo export --platform web && bash scripts/post-export.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/assets/node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/:file",
      "destination": "/fonts/:file"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!_expo|assets|fonts|favicon.ico|api).*)",
      "destination": "/index.html"
    }
  ]
}
