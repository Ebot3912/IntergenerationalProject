{
  "expo": {
    "name": "Intergenerational Bridge",
    "slug": "IntergenerationalApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B48FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smallhandsbighearts.bridgeapp",
      "infoPlist": {
        "NSCameraUsageDescription": "We need your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "We need access to your photos to set a profile picture.",
        "NSLocationWhenInUseUsageDescription": "We need your location to share in emergencies.",
        "NSContactsUsageDescription": "We need access to contacts for emergency contact setup.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bridgeapp.intergenerational",
      "adaptiveIcon": {
        "backgroundColor": "#6B48FF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.SEND_SMS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "9ba09866-d283-4ff2-8fb1-9a09413a76f9"
      }
    }
  }
}
