{
  "expo": {
    "name": "BridgeApp",
    "slug": "IntergenerationalApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B48FF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "We need your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "We need access to your photos to set a profile picture.",
        "NSLocationWhenInUseUsageDescription": "We need your location to share in emergencies.",
        "NSContactsUsageDescription": "We need access to contacts for emergency contact setup."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B48FF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "SEND_SMS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      "expo-web-browser"
    ]
  }
}
